<UserControl x:Class="CabinaElectrica3D.UI.CabinaPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="280"
             Background="#0F1A2B"
             FontFamily="Segoe UI"
             FontSize="12">

    <UserControl.Resources>

        <!-- COLORES -->
        <SolidColorBrush x:Key="BgBrush"       Color="#0F1A2B"/>
        <SolidColorBrush x:Key="SurfaceBrush"  Color="#13243A"/>
        <SolidColorBrush x:Key="BorderBrush"   Color="#1E3F66"/>
        <SolidColorBrush x:Key="GoldBrush"     Color="#E8A000"/>
        <SolidColorBrush x:Key="TextBrush"     Color="#C8D8EC"/>
        <SolidColorBrush x:Key="DimBrush"      Color="#5A7090"/>
        <SolidColorBrush x:Key="HeadBrush"     Color="#E8F0FB"/>

        <!-- LABEL STYLE -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource DimBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Margin"      Value="0,8,0,2"/>
        </Style>

        <!-- SECTION TITLE -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource HeadBrush}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Margin"      Value="0,4,0,10"/>
        </Style>

        <!-- TEXTBOX STYLE -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background"        Value="#0A1929"/>
            <Setter Property="Foreground"        Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="6,4"/>
            <Setter Property="CaretBrush"        Value="{StaticResource GoldBrush}"/>
            <Setter Property="SelectionBrush"    Value="#E8A00040"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CHECKBOX STYLE -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin"     Value="0,6,0,0"/>
        </Style>

        <!-- GENERATE BUTTON -->
        <Style x:Key="GenerateBtn" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource GoldBrush}"/>
            <Setter Property="Foreground"   Value="#0A1929"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Padding"      Value="0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFBA20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CC8C00"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TAB ITEM STYLE -->
        <Style TargetType="TabItem">
            <Setter Property="Background"   Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"   Value="{StaticResource DimBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding"      Value="10,6"/>
            <Setter Property="FontSize"     Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
                    <Setter Property="Background" Value="#13243A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SEPARATOR -->
        <Style TargetType="Separator">
            <Setter Property="Background"   Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin"       Value="0,12,0,4"/>
        </Style>

    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- HEADER -->
        <Border DockPanel.Dock="Top"
                Background="#0A1929"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <StackPanel>
                <TextBlock Text="⚡ CABINA ELÉCTRICA 3D"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{StaticResource GoldBrush}"/>
                <TextBlock Text="Configurador de transformación MT/BT"
                           Foreground="{StaticResource DimBrush}"
                           FontSize="10"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- GENERATE BUTTON (bottom) -->
        <Border DockPanel.Dock="Bottom"
                Padding="14,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Button x:Name="BtnGenerate"
                    Content="▶  GENERAR CABINA"
                    Style="{StaticResource GenerateBtn}"
                    Click="BtnGenerate_Click"/>
        </Border>

        <!-- TAB CONTROL — SECCIONES DE CONFIGURACIÓN -->
        <TabControl Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Padding="0">

            <!-- ── CASETA ── -->
            <TabItem Header="Caseta">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,10">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Geometría de la caseta prefabricada"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Ancho (m) — eje X"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CasetaWidth, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Profundidad (m) — eje Y"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CasetaDepth, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Altura interior libre (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CasetaHeight, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Espesor de muros (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CasetaWallThickness, UpdateSourceTrigger=PropertyChanged}"/>

                        <Separator/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Número de puertas"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CasetaDoorCount, UpdateSourceTrigger=PropertyChanged}"/>

                        <CheckBox Content="Rejillas de ventilación laterales"
                                  IsChecked="{Binding CasetaIncludeVentilation}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TRANSFORMADOR ── -->
            <TabItem Header="Trafo">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,10">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Transformador de potencia"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Potencia nominal (kVA)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding TrafoPowerKva, UpdateSourceTrigger=PropertyChanged}"/>

                        <Separator/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Ancho de cuba (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding TrafoTankWidth, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Profundidad de cuba (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding TrafoTankDepth, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Altura de cuba (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding TrafoTankHeight, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Columnas de radiadores"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding TrafoRadiatorColumns, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Offset desde pared izquierda (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding TrafoOffsetLeft, UpdateSourceTrigger=PropertyChanged}"/>

                        <CheckBox Content="Generar bornes MT y BT"
                                  IsChecked="{Binding TrafoIncludeTerminals}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── CELDAS MT ── -->
            <TabItem Header="Celdas">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,10">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Celdas de media tensión"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Número de módulos"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CeldasModuleCount, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Ancho por módulo (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CeldasModuleWidth, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Profundidad por módulo (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CeldasModuleDepth, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Altura por módulo (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CeldasModuleHeight, UpdateSourceTrigger=PropertyChanged}"/>

                        <CheckBox Content="Barras de embarrado trifásico"
                                  IsChecked="{Binding CeldasIncludeBusbars}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── CUADRO BT / ACOMETIDA ── -->
            <TabItem Header="BT / Acom.">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,10">

                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Cuadro de distribución BT"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Ancho del cuadro (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CuadroWidth, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Altura del cuadro (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CuadroHeight, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Columnas de módulos DIN"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding CuadroColumnCount, UpdateSourceTrigger=PropertyChanged}"/>

                        <Separator/>

                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Acometida MT"/>

                        <CheckBox Content="Subterránea (desmarca = aérea)"
                                  IsChecked="{Binding AcometidaIsUnderground}"
                                  Margin="0,0,0,8"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Longitud de acometida (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding AcometidaLength, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Número de cables"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding AcometidaCableCount, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Diámetro de cable (m)"/>
                        <TextBox Style="{StaticResource FieldBox}"
                                 Text="{Binding AcometidaCableDiameter, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── INSTALACIONES ── -->
            <TabItem Header="Inst.">
                <StackPanel Margin="14,14">
                    <TextBlock Style="{StaticResource SectionTitle}"
                               Text="Instalaciones auxiliares"/>

                    <CheckBox Content="Bandejas portacables perimetrales"
                              IsChecked="{Binding InstIncludeCableTrays}"/>

                    <CheckBox Content="Conductor de puesta a tierra (anillo)"
                              IsChecked="{Binding InstIncludeEarthingRing}"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
